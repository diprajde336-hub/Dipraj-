<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Flashcards</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Bricolage+Grotesque:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{
  --desk:#E3E9E6; --surface:#F6F9F8; --card:#FFFFFF; --ink:#1D2842; --muted:#56627C;
  --line:#C9D3E3; --ruled:#E3ECF8; --margin:#D9475F; --accent:#2F5BEA; --accent-ink:#FFFFFF;
  --bad:#B63C2B; --bad-bg:#F9E0DB;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --desk:#12161E; --surface:#1A202B; --card:#222A38; --ink:#E8ECF5; --muted:#9AA6BE;
    --line:#33405A; --ruled:#2A3449; --margin:#E8657B; --accent:#7C9BFF; --accent-ink:#0F1730;
    --bad:#FF8E7C; --bad-bg:#43211C;
  }
}
:root[data-theme="dark"]{
  --desk:#12161E; --surface:#1A202B; --card:#222A38; --ink:#E8ECF5; --muted:#9AA6BE;
  --line:#33405A; --ruled:#2A3449; --margin:#E8657B; --accent:#7C9BFF; --accent-ink:#0F1730;
  --bad:#FF8E7C; --bad-bg:#43211C;
}
html{scroll-padding-top:env(safe-area-inset-top,0px);background:var(--desk)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--desk);color:var(--ink);font:400 17px/1.5 "Atkinson Hyperlegible",system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-text-size-adjust:100%}
.wrap{max-width:680px;margin:0 auto;padding:22px 18px 72px}
h1,h2{font-family:"Bricolage Grotesque",system-ui,sans-serif;letter-spacing:-.02em;margin:0}
h1{font-size:clamp(28px,6vw,38px);line-height:1.1}
h2{font-size:22px}
.head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:22px}
.count{color:var(--muted);font-weight:700;white-space:nowrap}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.btn{font:inherit;font-weight:700;border:0;border-radius:10px;padding:12px 20px;cursor:pointer;background:var(--accent);color:var(--accent-ink);min-height:44px}
.btn.ghost{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 1.5px var(--line)}
.btn.danger{background:transparent;color:var(--bad);box-shadow:inset 0 0 0 1.5px var(--bad)}
.btn.sm{padding:7px 14px;min-height:38px;font-size:16px}
.btn:disabled{opacity:.4;cursor:not-allowed}
.stage{perspective:1400px}
.card{display:grid;min-height:290px;transform-style:preserve-3d;transition:transform .55s cubic-bezier(.3,.7,.2,1);border-radius:14px}
.card.flipped{transform:rotateY(180deg)}
.card.noanim{transition:none}
.face{
  grid-area:1/1;position:relative;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;
  padding:64px 32px 30px;border-radius:14px;background-color:var(--card);
  background-image:linear-gradient(var(--margin),var(--margin)),repeating-linear-gradient(to bottom,transparent 0,transparent 35px,var(--ruled) 35px,var(--ruled) 36px);
  background-size:100% 3px,100% 100%;background-repeat:no-repeat;background-position:0 46px,0 0;
  backface-visibility:hidden;-webkit-backface-visibility:hidden;
  box-shadow:0 14px 30px -14px rgba(20,30,60,.4);
}
.face.back{transform:rotateY(180deg)}
.tag{position:absolute;top:12px;left:32px;font-size:14px;font-weight:700;color:var(--muted)}
.txt{font-family:"Bricolage Grotesque",system-ui,sans-serif;font-weight:500;font-size:clamp(22px,4.6vw,30px);line-height:1.3;overflow-wrap:anywhere;width:100%;white-space:pre-wrap}
.nav{display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:10px;margin-top:22px}
.tools{display:flex;gap:10px;justify-content:flex-end;margin-top:14px}
.hint{color:var(--muted);font-size:14px;margin:18px 0 0}
@media (hover:none){.hint{display:none}}
.empty{background:var(--surface);border-radius:16px;padding:34px 22px;text-align:center;color:var(--muted)}
.empty p{margin:0 0 16px}
.manage{margin-top:46px}
.manage-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}
.list{background:var(--surface);border-radius:16px;overflow:hidden}
.item{display:flex;gap:12px;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line)}
.item:last-child{border-bottom:0}
